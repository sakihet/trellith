{
  "name": "trellith",
  "version": "0.12.8",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "preview": "vite preview",
    "size": "npm run build && size-limit",
    "test": "vitest"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "preact": "11.2.0",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@size-limit/file": "14.3.0",
    "@types/uuid": "10.0.0",
    "colorjs.io": "0.7.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "size-limit": "14.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "wouter-preact": "3.13.0"
  },
  "size-limit": [
    {
      "limit": "100 kB",
      "path": "dist/assets/index-*.js"
    }
  ],
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
